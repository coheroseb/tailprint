{
  "name": "tailprint",
  "version": "1.4.0",
  "description": "Developer-First PDF & Document Engine, TypeScript SDK & MCP Server (tailprint.com)",
  "type": "module",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "exports": {
    ".": "./dist/sdk/index.js",
    "./sdk": "./dist/sdk/index.js",
    "./server": "./dist/server.js"
  },
  "bin": {
    "tailprint": "dist/mcp/stdio.js",
    "tailprint-mcp": "dist/mcp/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coheroseb/tailprint.git"
  },
  "homepage": "https://tailprint.com",
  "bugs": {
    "url": "https://github.com/coheroseb/tailprint/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "test": "vitest run"
  },
  "keywords": [
    "pdf",
    "document",
    "html-to-pdf",
    "tailwind",
    "factur-x",
    "zugferd",
    "einvoice",
    "mcp-server",
    "model-context-protocol",
    "pdf-merge",
    "pdf-split",
    "pdf-forms",
    "typescript-sdk",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/swagger": "^9.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@scalar/fastify-api-reference": "^1.25.105",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@upstash/redis": "^1.34.4",
    "cryptpdf": "^0.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "jsdom": "^29.1.1",
    "nodemailer": "^10.5.0",
    "p-limit": "^6.2.0",
    "pdf-lib": "^1.17.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.50.1",
    "qrcode": "^1.5.4",
    "stripe": "^17.7.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
