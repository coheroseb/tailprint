{
  "name": "tailprint",
  "version": "1.0.0",
  "description": "Tailwind-Native Render & PDF Engine + AI Web Scraper (tailprint.com)",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "tailprint": "./dist/mcp/stdio.js",
    "tailprint-mcp": "./dist/mcp/stdio.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "test": "vitest run"
  },
  "keywords": [
    "fastify",
    "tailwind",
    "pdf",
    "screenshot",
    "eaas",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/swagger": "^9.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@scalar/fastify-api-reference": "^1.25.105",
    "@upstash/redis": "^1.34.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "jsdom": "^29.1.1",
    "p-limit": "^6.2.0",
    "playwright": "^1.50.1",
    "stripe": "^17.7.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.5",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
