{
    "name": "tailprint/tailprint",
    "description": "Official PHP & Laravel SDK for Tailprint — Developer-First Tailwind HTML to PDF, Hosted Templates & Factur-X E-Invoicing Engine",
    "keywords": [
        "pdf",
        "html-to-pdf",
        "tailwind",
        "laravel",
        "laravel-pdf",
        "factur-x",
        "zugferd",
        "einvoice",
        "document-generation",
        "tailprint"
    ],
    "homepage": "https://tailprint.com",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Tailprint",
            "email": "reach@clewaa.com",
            "homepage": "https://tailprint.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "illuminate/support": "Required for Laravel ServiceProvider, Facade, and Blade view rendering (^10.0|^11.0|^12.0)",
        "illuminate/http": "Required for fluent ->download() and ->stream() HTTP responses in Laravel"
    },
    "autoload": {
        "psr-4": {
            "Tailprint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tailprint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tailprint\\Laravel\\TailprintServiceProvider"
            ],
            "aliases": {
                "Tailprint": "Tailprint\\Laravel\\Facades\\Tailprint"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
