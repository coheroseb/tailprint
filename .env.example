# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Upstash Redis (Optional for local dev - has built-in In-Memory fallback)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Browser & Rendering Engine Concurrency
CONCURRENCY_LIMIT=5
RENDER_TIMEOUT_MS=8000
CACHE_TTL_SECONDS=604800

# Tailwind CDN
TAILWIND_CDN_URL=https://cdn.tailwindcss.com

# Default Local Dev API Key (seeded in memory store when Upstash is omitted)
DEV_DEFAULT_API_KEY=sec_live_dev_test_key_12345
